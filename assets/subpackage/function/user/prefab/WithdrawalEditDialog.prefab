: 0,"_parent": {"__id__": 332},"_children": [],"_active": true,"_components": [{"__id__": 334},{"__id__": 336}],"_prefab": {"__id__": 338},"_lpos": {"__type__": "cc.Vec3","x": 0,"y": 0,"z": 0},"_lrot": {"__type__": "cc.Quat","x": 0,"y": 0,"z": 0,"w": 1},"_lscale": {"__type__": "cc.Vec3","x": 1,"y": 1,"z": 1},"_mobility": 0,"_layer": 1073741824,"_euler": {"__type__": "cc.Vec3","x": 0,"y": 0,"z": 0},"_id": "23Y9FjDNhGd5436qRr9//Q"},{"__type__": "cc.UITransform","_name": "","_objFlags": 0,"node": {"__id__": 333},"_enabled": true,"__prefab": {"__id__": 335},"_contentSize": {"__type__": "cc.Size","width": 608,"height": 801.36},"_anchorPoint": {"__type__": "cc.Vec2","x": 0.5,"y": 1},"_id": "29wVJuq19PjKjfB/t/Gtnb"},{"__type__": "cc.CompPrefabInfo","fileId": "92t3x92MpNII1HlEP/Negs"},{"__type__": "cc.RichText","_name": "","_objFlags": 0,"node": {"__id__": 333},"_enabled": true,"__prefab": {"__id__": 337},"_lineHeight": 36,"_string": "<b><color=#000000>Attention: Pay attention to the distinction between i and L.</color></b>\n<color=#00000>E.g. The first character of IPOS0000001 is ‘i’, not ‘L’.</color>\n<b><color=#00000>\nHow to find IFSC code?</color></b>\n<color=#00000>1.IFSC Code is a unique 11 characters which is a combination of alphabets and numbers.\n2.First 4 characters are alphabetic characters representing the bank name. A list is given below for reference.\n3.5th character is 0 (zero) and reserved for future use.\n4.Last 6 characters are usually numbers but can also be alphabets. These represent a branch of the bank.\n5.IFSC code can be found on cheque leaf and bank passbook of the respective bank.\n6.Banks and respective branch list of IFSC codes can be obtained from Reserve Bank of India’s website.\n7.The IFSC code of a particular bank can also be found on the banks’ official website.</color>","_horizontalAlign": 0,"_verticalAlign": 0,"_fontSize": 26,"_maxWidth": 608,"_fontFamily": "Arial","_isSystemFontUsed": true,"_cacheMode": 0,"_handleTouchEvent": true,"_id": "13ygOSF45Kwp9PUa/t0984"},{"__type__": "cc.CompPrefabInfo","fileId": "ceyU9/oiJP5aF+u0oOPE99"},{"__type__": "cc.PrefabInfo","root": {"__id__": 1},"asset": {"__id__": 0},"fileId": "aaYdNxkdlFJoM47DgKspi5"},{"__type__": "cc.UIOpacity","_name": "","_objFlags": 0,"node": {"__id__": 332},"_enabled": true,"__prefab": {"__id__": 340},"_opacity": 255,"_id": "62bqEv9VdLPZBPV/kgP9B+"},{"__type__": "cc.CompPrefabInfo","fileId": "93H/rJujZOS4SkcARYa7Lu"},{"__type__": "cc.UITransform","_name": "","_objFlags": 0,"node": {"__id__": 332},"_enabled": true,"__prefab": {"__id__": 342},"_contentSize": {"__type__": "cc.Size","width": 640,"height": 801.36},"_anchorPoint": {"__type__": "cc.Vec2","x": 0.5,"y": 1},"_id": "0d3WFvxzpEL7Nu3+Zyi8sH"},{"__type__": "cc.CompPrefabInfo","fileId": "14bkfqlRlMNIzCT0G56Pcd"},{"__type__": "cc.Layout","_name": "","_objFlags": 0,"node": {"__id__": 332},"_enabled": true,"__prefab": {"__id__": 344},"_resizeMode": 1,"_layoutType": 2,"_cellSize": {"__type__": "cc.Size","width": 40,"height": 40},"_startAxis": 0,"_paddingLeft": 0,"_paddingRight": 0,"_paddingTop": 0,"_paddingBottom": 0,"_spacingX": 0,"_spacingY": 0,"_verticalDirection": 1,"_horizontalDirection": 0,"_constraint": 0,"_constraintNum": 2,"_affectedByScale": false,"_isAlign": true,"_id": "81gWHpBghCO7ULdVcg+Pmu"},{"__type__": "cc.CompPrefabInfo","fileId": "4bCAXVMjVNiIr24C0aofVT"},{"__type__": "cc.PrefabInfo","root": {"__id__": 1},"asset": {"__id__": 0},"fileId": "53jYaJVpxIUoxMWjLtAN6v"},{"__type__": "cc.Mask","_name": "","_objFlags": 0,"node": {"__id__": 331},"_enabled": true,"__prefab": {"__id__": 347},"_type": 0,"_inverted": false,"_segments": 64,"_alphaThreshold": 0,"_id": "c1VbYNsIhLLYmXSSOrVDIf"},{"__type__": "cc.CompPrefabInfo","fileId": "5cMaZPp7VDX5ypQ/MxsxkK"},{"__type__": "cc.Widget","_name": "","_objFlags": 0,"node": {"__id__": 331},"_enabled": true,"__prefab": {"__id__": 349},"_alignFlags": 45,"_left": 0,"_right": 0,"_top": 0,"_bottom": 0,"_horizontalCenter": 0,"_verticalCenter": 0,